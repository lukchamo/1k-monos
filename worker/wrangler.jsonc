{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laboratorio-inversionistas",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // observabilidad: logs y trazas de cada invocación, consultables en el panel de Cloudflare
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "invocation_logs": true }, "traces": { "enabled": true } },
  "upload_source_maps": true,

  // D1: libro mayor (precios, noticias, señales, métricas). Crear con:
  //   npx wrangler d1 create lab-inversionistas   → pegar aquí el database_id
  "d1_databases": [
    { "binding": "DB", "database_name": "lab-inversionistas", "database_id": "REEMPLAZAR-CON-EL-ID", "migrations_dir": "migrations" }
  ],

  // R2: texto crudo de cada noticia y la respuesta del modelo
  "r2_buckets": [{ "binding": "RAW", "bucket_name": "lab-inversionistas-raw" }],

  // un Durable Object por inversionista, con SQLite propio
  "durable_objects": { "bindings": [{ "name": "INVESTOR", "class_name": "InvestorDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InvestorDO"] }],

  // backtests bajo demanda
  "workflows": [{ "name": "lab-backtest", "binding": "BACKTEST", "class_name": "BacktestWorkflow" }],

  // Workers AI, siempre a través de AI Gateway (caché, registro, límites, cambio de proveedor)
  "ai": { "binding": "AI" },

  // límites de ritmo por IP (guardarraíl de la API pública)
  "ratelimits": [
    { "name": "RL_READ", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_HEAVY", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ],

  "vars": {
    "TAXONOMY_VERSION": "tax-1.0",
    "PROMPT_VERSION": "extract-1.0",
    "AI_GATEWAY_ID": "lab-inversionistas",
    "EXTRACT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },

  "triggers": {
    "crons": [
      "*/15 * * * *", // noticias
      "30 22 * * 1-5" // precios + decisiones, tras el cierre de EE. UU.
    ]
  }

  // secretos: npx wrangler secret put FIRECRAWL_API_KEY | TWELVE_DATA_API_KEY | MCP_TOKEN
}
